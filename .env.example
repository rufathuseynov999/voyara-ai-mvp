# Browser-safe values. Use the current Supabase publishable key format.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only values. Never prefix either value with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Production Auth also requires exact redirect URLs and launch-grade SMTP in Supabase.
# Never place SMTP credentials or the secret key in NEXT_PUBLIC_ variables.

# Local visual review only. Production validation rejects demo mode.
VOYARA_DEMO_MODE=false
VOYARA_DEMO_ROLE=founder
VOYARA_LOG_LEVEL=info

# Production-only operational controls. Generate a unique health token in the
# deployment secret store; never reuse a Supabase key. Use the immutable release
# or commit identifier deployed by the hosting platform.
VOYARA_HEALTH_TOKEN=replace_with_at_least_32_random_characters
VOYARA_RELEASE_ID=replace_with_release_identifier

# Phase 3A — supplier & payment integration (Part 1 foundation only).
# Modes: SIMULATION (safe default, non-authoritative and always labelled),
# SANDBOX (provider test environment), LIVE (real; gated). Adapters are opaque,
# non-secret identifiers. Live booking is DISABLED by default and may only be
# enabled when BOTH modes are LIVE and a webhook secret is present; any invalid
# combination fails closed (the app refuses to start rather than downgrade).
VOYARA_SUPPLIER_MODE=SIMULATION
VOYARA_SUPPLIER_ADAPTER=simulation
VOYARA_PAYMENT_MODE=SIMULATION
VOYARA_PAYMENT_ADAPTER=simulation

# Server-only. Required only when any mode is LIVE. Never prefix with NEXT_PUBLIC_.
VOYARA_WEBHOOK_SECRET=replace_with_at_least_32_random_characters

# Master safety flag for real bookings. Must remain false outside a fully
# LIVE, secret-configured production environment.
VOYARA_LIVE_BOOKING_ENABLED=false

# Phase 4H — Instagram Messaging (dual-brand: R-Travel + VOYARA). Fully
# optional: absent entirely by default, and the app runs correctly with
# none of this set (Instagram simply stays NOT_CONFIGURED). Every value
# below is server-only — never prefix any of them with NEXT_PUBLIC_.
#
# Shared Meta App credentials (one Meta App owns both brands' Pages):
#   VOYARA_META_APP_ID                    required together, server-only,
#   VOYARA_META_APP_SECRET                founder/provider-supplied from
#   VOYARA_INSTAGRAM_WEBHOOK_VERIFY_TOKEN  the Meta Developer Console, all
#   VOYARA_INSTAGRAM_CALLBACK_URL          four or none — partial is rejected.
#     Validation: app secret and webhook verify token must be real
#     (non-placeholder) strings at least 16 chars; callback URL must be
#     HTTPS. Activation stage: required before EITHER brand's webhook can
#     receive events; harmless to set before any brand account is connected.
#
# Optional — Graph API version pin (defaults to v21.0 if unset):
VOYARA_INSTAGRAM_GRAPH_API_VERSION=v21.0
#
# R-Travel brand account (all three required together, or leave all unset):
#   VOYARA_INSTAGRAM_RTRAVEL_ACCOUNT_ID   founder/provider-supplied, from
#   VOYARA_INSTAGRAM_RTRAVEL_PAGE_ID      the connected Instagram Business
#   VOYARA_INSTAGRAM_RTRAVEL_ACCESS_TOKEN account + its linked Facebook Page.
#     Activation stage: required only once R-Travel's Instagram account is
#     actually connected in Meta Business Suite — safe to leave unset
#     indefinitely if R-Travel Instagram is not yet in scope.
#
# VOYARA brand account (all three required together, or leave all unset):
#   VOYARA_INSTAGRAM_VOYARA_ACCOUNT_ID    founder/provider-supplied, same
#   VOYARA_INSTAGRAM_VOYARA_PAGE_ID       requirements as R-Travel above,
#   VOYARA_INSTAGRAM_VOYARA_ACCESS_TOKEN  for VOYARA's own IG account.
#     Validation (both brands): R-Travel and VOYARA may never share the
#     same account id, Page id, or access token — the app refuses to start
#     if they do (brand isolation, enforced in code, not just by convention).
#
# Master safety switch — must remain false until real Meta App Review and
# both connected accounts are fully verified. This flag alone does not
# enable live sending; it exists so activation can be staged deliberately
# rather than becoming "live" the moment credentials are typed in.
VOYARA_INSTAGRAM_ACTIVATION_ENABLED=false
