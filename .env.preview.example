# VOYARA AI — Preview environment template (Vercel preview deployments).
# Set these in Vercel → Project → Settings → Environment Variables, scoped to
# "Preview" only. Vercel sets VERCEL_ENV=preview automatically; do not set it
# by hand. Preview points at a separate STAGING Supabase project — never the
# production project — so preview testing can never touch real customer data.

# Browser-safe values. Use the STAGING Supabase project's publishable key.
NEXT_PUBLIC_APP_URL=https://your-branch-name.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://your-staging-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only values. Never prefix either with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Must include sslmode=require (or verify-ca / verify-full).
DATABASE_URL=postgresql://postgres:PASSWORD@db.your-staging-project.supabase.co:5432/postgres?sslmode=require

# Demo mode is forbidden outside Local — Preview validation rejects it.
VOYARA_DEMO_MODE=false
VOYARA_LOG_LEVEL=info

# Phase 3A/3B — supplier & payment integration. Preview stays SIMULATION;
# live modes are not exercised in Preview.
VOYARA_SUPPLIER_MODE=SIMULATION
VOYARA_SUPPLIER_ADAPTER=simulation
VOYARA_PAYMENT_MODE=SIMULATION
VOYARA_PAYMENT_ADAPTER=simulation
VOYARA_WEBHOOK_SECRET=replace_with_at_least_32_random_characters
VOYARA_LIVE_BOOKING_ENABLED=false

# Optional — see docs/phase-3c/VOYARA-PHASE-3C-AUTH-DEPLOYMENT-RUNBOOK.md.
VOYARA_ERROR_MONITOR_WEBHOOK=
