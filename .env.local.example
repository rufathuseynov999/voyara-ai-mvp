# Browser-safe values. Use the current Supabase publishable key format.
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server-only values. Never prefix either value with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Production Auth also requires exact redirect URLs and launch-grade SMTP in Supabase.
# Never place SMTP credentials or the secret key in NEXT_PUBLIC_ variables.

# Local visual review only. Production validation rejects demo mode.
VOYARA_DEMO_MODE=false
VOYARA_DEMO_ROLE=founder
VOYARA_LOG_LEVEL=info

# Production-only operational controls. Generate a unique health token in the
# deployment secret store; never reuse a Supabase key. Use the immutable release
# or commit identifier deployed by the hosting platform.
VOYARA_HEALTH_TOKEN=replace_with_at_least_32_random_characters
VOYARA_RELEASE_ID=replace_with_release_identifier

# Phase 3A — supplier & payment integration (Part 1 foundation only).
# Modes: SIMULATION (safe default, non-authoritative and always labelled),
# SANDBOX (provider test environment), LIVE (real; gated). Adapters are opaque,
# non-secret identifiers. Live booking is DISABLED by default and may only be
# enabled when BOTH modes are LIVE and a webhook secret is present; any invalid
# combination fails closed (the app refuses to start rather than downgrade).
VOYARA_SUPPLIER_MODE=SIMULATION
VOYARA_SUPPLIER_ADAPTER=simulation
VOYARA_PAYMENT_MODE=SIMULATION
VOYARA_PAYMENT_ADAPTER=simulation

# Server-only. Required only when any mode is LIVE. Never prefix with NEXT_PUBLIC_.
VOYARA_WEBHOOK_SECRET=replace_with_at_least_32_random_characters

# Master safety flag for real bookings. Must remain false outside a fully
# LIVE, secret-configured production environment.
VOYARA_LIVE_BOOKING_ENABLED=false
