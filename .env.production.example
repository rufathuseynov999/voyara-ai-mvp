# VOYARA AI — Production environment template (the apex domain).
# Set these in Vercel → Project → Settings → Environment Variables, scoped to
# "Production" only. Vercel sets VERCEL_ENV=production automatically; do not
# set it by hand. Every value below must be a real, non-placeholder secret —
# validateProductionEnvironment() (npm run launch:check) fails closed on any
# placeholder, non-HTTPS origin, or missing TLS on the database connection.

NEXT_PUBLIC_APP_URL=https://app.voyara.ai
NEXT_PUBLIC_SUPABASE_URL=https://your-production-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

SUPABASE_SECRET_KEY=sb_secret_replace_me
DATABASE_URL=postgresql://postgres:PASSWORD@db.your-production-project.supabase.co:5432/postgres?sslmode=verify-full

VOYARA_DEMO_MODE=false
VOYARA_LOG_LEVEL=warn

# Dedicated secrets — must NOT equal the Supabase keys above and must not be
# placeholders. Generate with: openssl rand -hex 32
VOYARA_HEALTH_TOKEN=replace_me_with_a_unique_secret
# The immutable release/commit id the hosting platform deployed (Vercel:
# VERCEL_GIT_COMMIT_SHA is a good source — wire it explicitly, do not rely on
# Vercel's own env var name in application code).
VOYARA_RELEASE_ID=replace_me_with_release_id

# Phase 3A/3B — supplier & payment integration. Remains SIMULATION until a
# live-provider activation phase explicitly turns this on; see Phase 3B/3C
# reports. Changing these outside that process is a policy violation, not
# just a config change.
VOYARA_SUPPLIER_MODE=SIMULATION
VOYARA_SUPPLIER_ADAPTER=simulation
VOYARA_PAYMENT_MODE=SIMULATION
VOYARA_PAYMENT_ADAPTER=simulation
VOYARA_WEBHOOK_SECRET=replace_me_with_a_unique_secret
VOYARA_LIVE_BOOKING_ENABLED=false

# Optional — error-monitoring webhook hook. See
# docs/phase-3c/VOYARA-PHASE-3C-AUTH-DEPLOYMENT-RUNBOOK.md for wiring a real
# provider (Sentry, etc.) behind this hook. Leave blank to log-only.
VOYARA_ERROR_MONITOR_WEBHOOK=
